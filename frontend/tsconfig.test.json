// ROLE: TypeScript-конфигурация для тестов (vitest). Наследует основной tsconfig, добавляет node-типы.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Тесты читают общий JSON через node:fs и рендерят React-компоненты.
    "types": ["node", "vite/client"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "composite": false
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "vite.config.ts"],
  "exclude": []
}
